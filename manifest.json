{
  "manifest_version": 3,
  "name": "FreeStreaming",
  "version": "1.0.0",
  "description": "Block the opening of new tabs by websites.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeStreaming"
  }
}